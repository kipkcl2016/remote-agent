{
  "name": "macos-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pair": "tsx src/pair.ts",
    "package": "npm run build && node scripts/package.mjs",
    "service:install": "npm run build && tsx src/service-manager.ts install",
    "service:status": "tsx src/service-manager.ts status",
    "service:uninstall": "tsx src/service-manager.ts uninstall",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
